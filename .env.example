# Copy to .env.local and fill in. .env.local is gitignored.

# --- Required ---
ANTHROPIC_API_KEY=               # console.anthropic.com — matchmaking / clustering / copy
NEXT_PUBLIC_SUPABASE_URL=        # Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_ANON_KEY=   # Supabase → Project Settings → API → anon public key
SUPABASE_SERVICE_ROLE_KEY=       # Supabase → Project Settings → API → service_role key (SERVER ONLY)
NEXT_PUBLIC_APP_URL=http://localhost:3000   # used to build share links; prod = https://afterparty.digital

# --- Optional ---
PAGE_TOKEN_SECRET=               # HMAC secret for signing per-attendee page tokens
