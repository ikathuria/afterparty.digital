# Copy to .env.local and fill in. .env.local is gitignored.

# --- Required ---
DATABASE_URL=                    # Neon → your project → Connection string (pooled), e.g.
                                 # postgresql://user:pass@ep-xxx-pooler.region.neon.tech/neondb?sslmode=require
NEXT_PUBLIC_APP_URL=http://localhost:3000   # used to build share links; prod = https://afterparty.digital

# --- Optional ---
ANTHROPIC_API_KEY=               # console.anthropic.com — enables AI interest inference (app works without it)
PAGE_TOKEN_SECRET=               # reserved for signing per-attendee page tokens
SITE_PASSWORD=                   # if set, the WHOLE site requires this password (Basic Auth).
                                 # Leave empty for open local dev; set it on the deployed env
                                 # so the real demo data is never publicly accessible.
